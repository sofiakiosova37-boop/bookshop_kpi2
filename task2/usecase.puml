@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor LightPurple
    BorderColor DarkSlateGray
    ArrowColor DarkSlateGray
}

actor "Guest" as Guest
actor "Client" as Client
actor "Staff" as Staff
actor "Email Notifications" as EN

Guest <|-- Client

rectangle "Book club" {
    usecase "registration" as UC1
    usecase "checkout of purchase" as UC2
    usecase "checkout of rent" as UC3
    usecase "search and filter item" as UC4
    usecase "see meeting details" as UC5
    usecase "add meeting" as UC6
    usecase "cancel meeting" as UC7
    usecase "send email notification" as UC8
    usecase "manage bonuses" as UC9
    usecase "edit profile info" as UC10
    usecase "edit meeting" as UC11
    usecase "view purchase and rental history" as UC12
    usecase "register for a meeting" as UC13
    usecase "return rental item" as UC14
    usecase "add product" as UC15
    usecase "view bonus balance" as UC16
}

Guest --> UC1
Guest --> UC4
Guest --> UC5

Client -->UC4
Client -->UC5
Client -->UC10
Client -->UC12
Client -->UC13
Client -->UC14
Client -->UC16

Staff --> UC2
Staff --> UC3
Staff --> UC5
Staff --> UC6
Staff --> UC7
Staff --> UC9
Staff --> UC11
Staff --> UC12
Staff --> UC15

UC8 --EN

@enduml