@startuml
actor "Клієнт" as Customer
actor "Співробітник" as Staff
package "Book&Game Club" {
    package "UI" {
        component "StaffWeb" as Web
    }
    package "API" {
        component "Backend API" as API
    }
    package "Services" {
        component "Client Service" as CS
        component "Bonus Service" as BS
        component "Inventory Service" as IS
        component "Rental Service" as RS
        component "Notification Service" as NS
    }
    package "Data Access" {
        component "RentalRepository" as RentalR
        component "CopyRepository" as CopyR
        component "ClientRepository" as ClientR
    }
    package "Database" {
        component "PostgreSQL" as PostgreSQL
    }
}
@enduml