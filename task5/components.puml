/* 
--( компонент зліва потребує для роботи інтерфейс справа
-() компонент реалізує інтерфейс зправа
--> проста взаємодія
..> елемент зліва залежний (використовує) елемент справа
*/ 


@startuml
actor "Клієнт" as Customer
actor "Співробітник" as Staff
package "Book&Game Club" {
    package "UI" {
        component "StaffWeb" as Web
    }
    package "API" {
        component "Backend API" as API
        interface "InterfaceAPI" as IAPI
    }
    package "Services" {
        component "Client Service" as CS
        component "Bonus Service" as BS
        component "Inventory Service" as IS
        component "Rental Service" as RS
        component "Notification Service" as NS

        interface "IClient Service" as ICS
        interface "IBonus Service" as IBS
        interface"IInventory Service" as IIS
        interface "IRental Service" as IRS
        interface "INotification Service" as INS
    }
    package "Data Access" {
        component "RentalRepository" as RentalR
        component "CopyRepository" as CopyR
        component "ClientRepository" as ClientR

        interface "RentalRepository" as IRentalR
        interface "CopyRepository" as ICopyR
        interface "ClientRepository" as IClientR
    }
    package "Database" {
        component "PostgreSQL" as PostgreSQL
    }
    package "EmailService" {
        component "EmailS" as ES
    }
}

Staff --> Web
Customer --> ES : email notifications
Web --( IAPI
API -() IAPI

@enduml