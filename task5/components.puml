/* 
--( компонент зліва потребує для роботи інтерфейс справа
-() компонент реалізує інтерфейс зправа
--> проста взаємодія
..> елемент зліва залежний (використовує) елемент справа
*/ 


@startuml
actor "Клієнт" as Customer
actor "Співробітник" as Staff
package "Book&Game Club" {
    package "UI" {
        component "StaffWeb" as Web
    }
    package "API" {
        component "BackendAPI" as API
        interface "InterfaceAPI" as IAPI
    }
    package "Services" {
        component "ClientService" as CS
        component "BonusService" as BS
        component "InventoryService" as IS
        component "RentalService" as RS
        component "NotificationService" as NS

        interface "IClientService" as ICS
        interface "IBonusService" as IBS
        interface"IInventoryService" as IIS
        interface "IRentalService" as IRS
        interface "INotificationService" as INS
    }
    package "Data Access" {
        component "RentalRepository" as RentalR
        component "CopyRepository" as CopyR
        component "ClientRepository" as ClientR

        interface "IRentalRepository" as IRentalR
        interface "ICopyRepository" as ICopyR
        interface "IClientRepository" as IClientR
    }
    package "Database" {
        component "PostgreSQL" as PostgreSQL
        interface "IPostgreSQL" as ISQL
    }
    package "EmailService" {
        component "EmailS" as ES
        interface "IEmail" as IE
    }
}

Staff --> Web
Customer --> ES : email notifications
Web --( IAPI
API -() IAPI

CS -() ICS
BS -() IBS
IS -() IIS
RS -() IRS
NS -() INS

API --( IRS
API --( ICS
API --( IBS
API --( IIS

RS --( ICS
RS --( IBS
RS --( IIS
RS --( INS

PostgreSQL -() ISQL
RentalR --( ISQL
CopyR --( ISQL
ClientR --( ISQL

RentalR -() IRentalR
CopyR -() ICopyR
ClientR -() IClientR

RS --( IRentalR
CS --( IClientR
BS --( IClientR
IS --( ICopyR

ES -() IE
NS --( IE
@endumlm 