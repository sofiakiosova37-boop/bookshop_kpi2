# firts scenarion (succesfull rental)
# до чого йде стрілка те у мене вкл ->
# від чого йде стрілка то викл <--
@startuml
actor Співробітник as staff
participant WebInterface as ui
participant RentalService as service
actor Клієнт as cus
database База as DB
participant NotificationService as notify

cus -> staff: ask for book
staff -> ui ++: enter client's id & book unique number
ui -> service ++: forwards the request to check client
service -> DB ++: checks client's fines 
service <-- DB --: client has no fines 
service -> DB ++: check status of Book_Copy
service <-- DB --: return status "доступно"

opt Клієнт бажає використати бонуси
    staff -> ui ++: enter the number of bonus points to redeem
    ui -> service ++: applyBonuses
    service -> DB ++: update Client amount of bonuses
    service <-- DB --: bonuses deducted
    service -> notify ++: sendBonusNotification()
    notify -> cus: sends an email regarding the deduction of bonus points
    service <-- notify --: notification sent
    service <-- ui: success
    staff <-- ui: displays a message confirming the deduction of bonus points
end opt

service -> DB ++: creates a new record in rental
service <-- DB --: record created
service -> DB ++: refresh record in Book_Copy from "доступно" to "в оренді"
service <-- DB --: status updated
service -> notify ++: sendEmailNotification() for initializizing confirmation call
notify -> cus: send email confirmation
service <-- notify --: notification sent
ui <-- service --: successful message
staff <-- ui --: displays a success message
cus <-- staff: here your book and rental receipt
@enduml

# second scenarion (book is not available)
@startuml
actor Співробітник as staff
participant WebInterface as ui
participant RentalService as service
actor Клієнт as cus
database База as DB
participant NotificationService as notify

cus -> staff: ask for book
staff -> ui ++: enter client's id & book unique number
ui -> service ++: forwards the request to check client
service -> DB ++: checks client's fines
service <-- DB --: client has no fines
service -> DB ++: check status of Book_Copy
service <-- DB --: return status "в оренді"

alt status "в оренді"
    ui <-- service: error
    staff <-- ui: shows error message "Примірник недоступний" and suggests another copy

    loop (Until an available copy is found)
        staff -> ui: enter another book's unique number
        ui -> service: checkAlternativeBook()
        service -> DB ++: check status of alternative Book_Copy
        service <-- DB --: return status
    end loop

    service -> DB ++: creates a new record in rental
    service <-- DB --: record created
    service -> DB ++: refresh record in Book_Copy from "доступно" to "в оренді"
    service <-- DB --: status updated
    service -> notify ++: sendEmailNotification() for initializing confirmation email
    notify -> cus: send email confirmation
    service <-- notify --: notification sent
end alt

ui <-- service --: successful message
staff <-- ui --: displays a success message
cus <-- staff: here your book and rental receipt
@enduml

# third scenarion (return in time)
@startuml
actor Співробітник as staff
participant WebInterface as ui
participant RentalService as service
actor Клієнт as cus
database База as DB
participant NotificationService as notify

cus -> staff: brings the book for return
staff -> ui ++: enter book copy unique number & return request
ui -> service ++: returnRentalRequest()
service -> DB ++: find an active rental for this copy
service <-- DB --: returns rental data (issue date, return_date)
service -> service: compare current date with return_date calculateDaysOverdue() 

alt deadline not exceeded (on-time return)
    service -> DB ++: update status in rental to "повернено"
    service <-- DB --: status updated
    service -> DB ++: update status in Book_Copy to "доступно"
    service <-- DB --: status updated
    service -> notify ++: sendReturnConfirmation()
    notify -> cus: sends email regarding successful return
    service <-- notify --: notification sent
end alt

ui <-- service --: success (book accepted without penalties)
staff <-- ui --: displays success message
cus <-- staff: thank you, the return has been processed
@enduml

